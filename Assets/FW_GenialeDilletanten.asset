  m_Name: FW_GenialeDilletanten
  m_EditorClassIdentifier: Assembly-CSharp::FotowandData
  photo: {fileID: 21300000, guid: 11c5b5b8d0c664045b8db0242208bfa2, type: 3}
  title: "Grosse Untergangs-Show \u2013 Festival Genialer Dilletanten, 1981"
  description: "A flyer for the legendary 'Grosse Untergangs-Show' festival at Tempodrom,
    Berlin, 4 September 1981 \u2014 featuring Einst\xFCrzende Neubauten, Blixa Bargeld,
    DIN A Testbild, and many more."
  hasExtraInfo: 1
  extraInfoTitle: Festival Genialer Dilletanten
  extraInfoContent: "The Festival Genialer Dilletanten (Festival of Genial Dilettantes)
    was a landmark event in West Berlin's underground art and music scene. Held at
    the Tempodrom in 1981, it brought together artists, musicians, and performers
    who rejected professional polish in favor of raw, experimental expression. Acts
    like Einst\xFCrzende Neubauten, who famously used industrial tools as instruments,
    embodied the festival's ethos. The event became a defining moment for the Neue
    Deutsche Welle and post-punk movements in Germany."
  extraInfoImage: {fileID: 0}
