  m_Script: {fileID: 11500000, guid: fbf53cf59c492414ba5ce3b9941f083c, type: 3}
  m_Name: FW_RockFanzine
  m_EditorClassIdentifier: Assembly-CSharp::FotowandData
  photo: {fileID: 21300000, guid: b275862746f4644439dc8d5b9b029e36, type: 3}
  title: "Rockmusik \u2013 Fanzine Nr. 7, M\xE4rz 1980"
  description: "The cover of Rockmusik fanzine, issue No. 7, March 1980 \u2014 a\nWest
    Berlin underground zine deliberately designed\nto mimic a supermarket discount
    flyer, listing records and\nreleases as if they were grocery bargains with prices
    in Deutschmark."
  hasExtraInfo: 1
  extraInfoTitle: Fanzines and Underground Media
  extraInfoContent: "Before the internet, fanzines were the lifeblood of underground\nmusic
    scenes. In West Berlin, publications like Rockmusik\nconnected fans, bands, and
    shops in a city cut off from the rest\nof Germany. This issue's striking design
    \u2014 mimicking the layout\nof a cheap supermarket advertisement, complete with
    mock\nprices and 'special offers' \u2014 was a sharp piece of satire, poking\nfun
    at consumer culture while spreading genuine music news.\nThis kind of playful,
    photocopied DIY aesthetic was itself a\nstatement, and shops like Zensor stocked
    and distributed such\nzines, making them media hubs as much as record stores."
  extraInfoImage: {fileID: 0}
