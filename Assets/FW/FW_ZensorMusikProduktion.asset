  m_Name: FW_ZensorMusikProduktion
  m_EditorClassIdentifier: Assembly-CSharp::FotowandData
  photo: {fileID: 21300000, guid: 8b2190940c4ffcb42820a25e931becde, type: 3}
  title: Zensor-Musik-Produktion
  description: "A promotional flyer listing the full roster of artists under Zensor's
    own music production label, including DIN A Testbild, frdaha p\xF8tzm*n, T4,
    Garbage, and many more \u2014 a snapshot of the entire Zensor creative network."
  hasExtraInfo: 1
  extraInfoTitle: Zensor as a Record Label
  extraInfoContent: "Beyond being a record shop, Zensor operated its own music production\nand
    tape label \u2014 Zensor-Musik-Produktion. The label released cassettes\nand
    records by local Berlin artists who had no other outlet for their work,\ncovering
    genres the founders called 'Electric Sonority', 'Tape- Production',\n'Disco-Production',
    and even 'Berlin Wall Engineering'. This DIY label model\nwas radical for its
    time, predating the widespread indie label boom and giving\na platform to artists
    like DIN A Testbild and Mittagspause who would later become\nkey figures of the
    Neue Deutsche Welle movement."
  extraInfoImage: {fileID: 0}
