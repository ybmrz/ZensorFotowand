  m_Name: FW_Throbbing
  m_EditorClassIdentifier: Assembly-CSharp::FotowandData
  photo: {fileID: 21300000, guid: f9b58ef7c4f2691439f0c07d6f5face9, type: 3}
  title: "Throbbing Gristle \u2013 Band Portrait, 1980"
  description: "A portrait of the four members of Throbbing Gristle \u2014 Genesis\nP-Orridge,
    Cosey Fanni Tutti, Peter 'Sleazy' Christopherson,\nand Chris Carter \u2014 pioneers
    of industrial music, photographed\naround 1980."
  hasExtraInfo: 1
  extraInfoTitle: Throbbing Gristle
  extraInfoContent: "Throbbing Gristle are widely regarded as the founders of\nindustrial
    music. Formed in 1975 out of the performance art\ngroup COUM Transmissions, they
    coined the term 'industrial'\nwith their label Industrial Records and its slogan
    'industrial\nmusic for industrial people'. Their confrontational sound \u2014
    built\nfrom tape loops, distortion, and electronics \u2014 and their\nprovocative
    aesthetic made them deeply influential on the West\nBerlin underground. Their
    1980 performance at S036 connected\ntwo of Europe's most vital experimental scenes,
    and their self\nreleased live cassettes directly inspired the DIY tape philosophy\nembraced
    by shops like Zensor."
  extraInfoImage: {fileID: 21300000, guid: b2abde25ac1fb3341a451eaee570a405, type: 3}
